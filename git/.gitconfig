[include]
  path = ~/dotfiles/.heyyou/gitconfig
  path = ~/dotfiles/git/catppuccin.gitconfig
[core]
  autocrlf = input
  excludesfile = ~/dotfiles/git/ignore
  quotepath = false
	editor = hx
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  side-by-side = true
  navigate = true
  dark = true
  line-numbers = true
  features = catppuccin-mocha
[diff]
  context = 1
[init]
  defaultBranch = main
[credential "https://github.com"]
  helper = 
  # mise のグローバル設定の gh を使う。-C "$HOME" はカレントリポジトリの mise.toml(未 trust / 別版 pin)を読ませないため。
  # PATH 上の mise / gh にはフォールバックしない: 共有 Mac では他ユーザーが書ける PATH(/opt/homebrew/bin)に偽 gh を置かれるとトークンを渡してしまうため。
  # MISE_AUTO_INSTALL=0 で認証の途中に gh のダウンロードを走らせず即失敗させる(導入は mise run install:dev-tools)。
  helper = "!f() { g=$(MISE_AUTO_INSTALL=0 \"$HOME/.local/bin/mise\" -C \"$HOME\" which gh) || exit 1; exec \"$g\" auth git-credential \"$@\"; }; f"
[credential "https://gist.github.com"]
  helper = 
  # mise のグローバル設定の gh を使う。-C "$HOME" はカレントリポジトリの mise.toml(未 trust / 別版 pin)を読ませないため。
  # PATH 上の mise / gh にはフォールバックしない: 共有 Mac では他ユーザーが書ける PATH(/opt/homebrew/bin)に偽 gh を置かれるとトークンを渡してしまうため。
  # MISE_AUTO_INSTALL=0 で認証の途中に gh のダウンロードを走らせず即失敗させる(導入は mise run install:dev-tools)。
  helper = "!f() { g=$(MISE_AUTO_INSTALL=0 \"$HOME/.local/bin/mise\" -C \"$HOME\" which gh) || exit 1; exec \"$g\" auth git-credential \"$@\"; }; f"
